# Shared Firebase project — same for the whole team
FIREBASE_PROJECT_ID=developers-networking-app

# Path to service account JSON (maintainers only — never commit the file)
# On Render/Railway: paste JSON into GOOGLE_APPLICATION_CREDENTIALS_JSON instead
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\serviceAccount.json

PORT=5000

# Comma-separated allowed browser origins (optional — leave empty for mobile-only)
# CORS_ORIGINS=https://your-admin-portal.example.com

# Optional Redis for distributed rate limiting (Upstash/Render Redis)
# REDIS_URL=redis://localhost:6379

# Legacy API sunset date (RFC 7231)
# API_LEGACY_SUNSET=Sat, 01 Nov 2026 00:00:00 GMT

# Render/Railway: set this env var to the full service account JSON string
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
