rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountRole == 'admin';
    }

    function projectData(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function isProjectMember(projectId, uid) {
      return exists(/databases/$(database)/documents/projects/$(projectId)/members/$(uid));
    }

    // Use resource.data (not get()) so list queries like
    // where ownerUserId == auth.uid and where visibility == 'public' are allowed.
    function canReadProject() {
      return resource.data.visibility == 'public'
        || resource.data.visibility == 'unlisted'
        || resource.data.ownerUserId == request.auth.uid
        || (resource.data.visibility == 'private'
            && isProjectMember(resource.id, request.auth.uid));
    }

    function canReadProjectDoc(projectId) {
      let p = projectData(projectId);
      return p.visibility == 'public'
        || p.visibility == 'unlisted'
        || p.ownerUserId == request.auth.uid
        || (p.visibility == 'private' && isProjectMember(projectId, request.auth.uid));
    }

    function memberRoleOrNull(projectId) {
      let path = /databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid);
      return exists(path)
        ? get(path).data.memberRole
        : null;
    }

    function canManageProject(projectId) {
      let p = projectData(projectId);
      let role = memberRoleOrNull(projectId);
      return p.ownerUserId == request.auth.uid
        || role == 'maintainer'
        || role == 'owner';
    }

    // Use resource.data for conversation reads so inbox queries
    // (array-contains participantIds) are allowed by security rules.
    function isConversationMember() {
      return signedIn()
        && request.auth.uid in resource.data.participantIds;
    }

    function isConversationParticipant(convId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
    }

    match /users/{userId} {
      // get: public profiles (login-by-username email lookup) + own profile when signed in
      allow get: if signedIn()
        || (resource != null && resource.data.profileVisibility == 'public');
      allow list: if signedIn();
      allow create: if isUser(userId)
        && request.resource.data.schemaVersion is int
        && request.resource.data.displayName is string
        && request.resource.data.usernameLower is string;
      allow update: if isUser(userId) || isAdmin();
      allow delete: if isUser(userId) || isAdmin();
    }

    match /usernames/{usernameLower} {
      // get: signup username availability + login-by-username (no list = no scraping)
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && usernameLower == request.resource.data.usernameLower;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /userStats/{userId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read: if signedIn() && (isAdmin() || canReadProject());
      allow create: if signedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.schemaVersion is int;
      allow update: if signedIn() && (canManageProject(projectId) || isAdmin());
      allow delete: if signedIn() && (projectData(projectId).ownerUserId == request.auth.uid || isAdmin());

      match /members/{memberId} {
        allow read: if signedIn() && canReadProjectDoc(projectId);
        allow create: if signedIn() && (
          canManageProject(projectId)
          || (
            memberId == request.auth.uid
            && getAfter(/databases/$(database)/documents/projects/$(projectId)).data.ownerUserId == request.auth.uid
          )
        );
        allow update: if signedIn() && canManageProject(projectId);
        allow delete: if signedIn() && (
            canManageProject(projectId)
            || (isUser(memberId) && request.auth.uid == memberId)
          );
      }

      match /tasks/{taskId} {
        allow read: if signedIn() && canReadProjectDoc(projectId);
        allow create, update: if signedIn() && canReadProjectDoc(projectId)
          && (
            projectData(projectId).ownerUserId == request.auth.uid
            || canManageProject(projectId)
            || isProjectMember(projectId, request.auth.uid)
          );
        allow delete: if signedIn() && canManageProject(projectId);
      }
    }

    match /conversations/{conversationId} {
      allow read: if isConversationMember();
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if isConversationMember();
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isConversationParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isConversationParticipant(conversationId);
        allow delete: if signedIn()
          && resource.data.senderId == request.auth.uid;
      }
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /registrations/{userId} {
        allow read: if signedIn();
        allow create: if signedIn() && userId == request.auth.uid;
        allow delete: if signedIn() && userId == request.auth.uid;
        allow update: if false;
      }
    }

    match /inbox/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.recipientUserId == request.auth.uid);
      allow create: if isAdmin()
        || (signedIn()
            && request.resource.data.recipientUserId != request.auth.uid
            && request.resource.data.schemaVersion is int
            && request.resource.data.recipientUserId is string
            && request.resource.data.title is string
            && request.resource.data.body is string);
      allow update: if signedIn()
        && resource.data.recipientUserId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.recipientUserId == request.auth.uid;
    }

    match /activity/{activityId} {
      allow read: if signedIn()
        && resource.data.audienceUserId == request.auth.uid;
      allow create: if false;
      allow update, delete: if false;
    }

    match /newsHighlights/{docId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /matchRequests/{requestId} {
      allow read: if isAdmin()
        || (signedIn()
            && (resource.data.fromUserId == request.auth.uid
                || resource.data.toUserId == request.auth.uid));
      allow create: if signedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.fromUserId != request.resource.data.toUserId;
      allow update: if isAdmin()
        || (signedIn()
            && (resource.data.toUserId == request.auth.uid
                || resource.data.fromUserId == request.auth.uid));
      allow delete: if false;
    }

    match /projectJoinRequests/{requestId} {
      allow read: if isAdmin()
        || (signedIn()
            && (resource.data.fromUserId == request.auth.uid
                || resource.data.toUserId == request.auth.uid));
      allow create: if signedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.schemaVersion is int;
      allow update: if isAdmin()
        || (signedIn() && resource.data.toUserId == request.auth.uid);
      allow delete: if false;
    }

    match /collaboratorSuggestions/{docId} {
      allow read: if signedIn()
        && resource.data.viewerUserId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.submitterUserId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.submitterUserId == request.auth.uid
        && request.resource.data.schemaVersion is int;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /contentReports/{reportId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.reporterUserId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.reporterUserId == request.auth.uid
        && request.resource.data.schemaVersion is int;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /productFeedback/{feedbackId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /platformConfig/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
